# ============================================================
# 模型接入配置（标准参数入口）
#
# 编排器与执行器可以是不同模型：
#   ORCH_*   负责拆解任务，需要强 JSON 遵循能力
#   WORKER_* 负责写代码调工具，需要强代码能力
# 若只配置 ORCH_*，WORKER_* 自动继承 ORCH_* 的接入信息与预算。
#
# 复制为 .env 使用（本文件是模板，不含真实密钥）。
# ============================================================

# ---------- 编排器 ----------
ORCH_MODEL=qwen2.5:7b
ORCH_BASE_URL=http://localhost:11434/v1
ORCH_API_KEY=ollama

# ---------- 执行器 ----------
# 留空则继承 ORCH_*。想用不同模型时取消下面注释：
# WORKER_MODEL=qwen2.5-coder:7b
# WORKER_BASE_URL=http://localhost:11434/v1
# WORKER_API_KEY=ollama

# ============================================================
# 预算参数
#
# 最省事的用法：只给 CONTEXT_WINDOW，其余按比例自动推导。
#   ctx<=8192   : rounds=15 steps=15 attempts=2
#   ctx<=32768  : rounds=20 steps=20 attempts=3
#   ctx>32768   : rounds=30 steps=25 attempts=3
#   max_tokens  : min(ctx/2, 4096)
#   回灌截断     : max(800, min(ctx/6, 8000)) 字符
#
# 需要精细控制时再单独覆盖下面任一项。
# ============================================================
ORCH_CONTEXT_WINDOW=8192

# ---------- 可选覆盖项（示例，取消注释即生效）----------
# ORCH_MAX_TOKENS=4096          # 单次生成上限
# ORCH_MAX_ROUNDS=15            # 主循环轮次上限
# ORCH_MAX_STEPS=15             # 单个子任务步数上限
# ORCH_MAX_ATTEMPTS=2           # 一个 cycle 最多尝试次数
# ORCH_MAX_ERRORS=3             # 连续工具报错上限
# ORCH_MAX_SAME_TASK=2          # 同一任务最多尝试次数
# ORCH_TOOL_RESULT_CHARS=1500   # 工具结果回灌截断长度（字符）
# ORCH_TEMPERATURE=0.1
# ORCH_TIMEOUT=120

# ============================================================
# 能力声明与耦合档
#
# 能力声明用于启动自检：不满足就显式报错，而不是静默劣化。
#   ORCH_JSON_MODE=true  模型是否支持 response_format={"type":"json_object"}
#
# 耦合档（COUPLING）把「针对某个模型的补偿」隔离在一处：
#   default  不做任何补偿（新模型建议先用这个）
#   qwen     识别「我将/首先我/…」等计划句式 + 宽松 JSON 修复
#   none     同 default
#
# 换模型时如果出现奇怪的重试行为，先把它设成 default 排除耦合干扰。
# ============================================================
ORCH_JSON_MODE=true
ORCH_COUPLING=qwen

# ============================================================
# 远程决策（人工介入）
#
# 决策流不必一直盯着：关键节点会挂起、推送给你、你在手机上作答后继续。
# 只在两处停：
#   1. 验证连续失败达阈值（模型能力不够的信号）
#   2. 即将回退、会覆盖已有文件之前
# 程序能判定的确定性事实（清单缺失、语法错误）不会打扰你。
# ============================================================

# 投递通道：console（默认，只打日志）| dingtalk | webhook | none
AGENT_NOTIFY_CHANNEL=console

# ---------- 钉钉群自定义机器人（个人可用、免费）----------
# 钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
# ⚠️ webhook 含 access_token，等同于密码，**不要提交进仓库**
# AGENT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# AGENT_DINGTALK_SECRET=SECxxx        # 仅当机器人开启了「加签」

# ---------- 通用 webhook（企业微信 / Slack / 自建中转）----------
# 企业微信机器人有正规 API，但需要企业/组织资质
# AGENT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# AGENT_WEBHOOK_TEMPLATE=wecom        # wecom | slack | plain

# ---------- 审批页 ----------
# ⚠️ 必须是**手机可达**的地址，不能是 127.0.0.1。
# 用 ipconfig 查本机局域网 IP，例如 192.168.1.10
AGENT_APPROVAL_BASE_URL=http://127.0.0.1:8000

# 访问令牌。留空 = 不鉴权（适合局域网自用）。
# 设置后所有决策接口都要求 ?t=<token>，把带 token 的链接存成手机书签。
# AGENT_APPROVAL_TOKEN=

# ---------- 决策行为（也可在 /encode 请求里逐次指定）----------
# auto   命中决策点直接用保守默认动作，不推送不等待（默认，等价旧行为）
# notify 落盘并推送，但不等待
# wait   落盘并推送，阻塞等待你在手机上作答
# AGENT_ON_DECISION=auto
# AGENT_MAX_CONSECUTIVE_FAILURES=2

# ============================================================
# 视觉角色（多模态预留）
#
# 独立角色，**不继承** ORCH：图像模型与代码模型通常不是同一个。
# 未配置即「未启用」——调用会显式失败，不会静默丢图
# （静默丢图会让模型凭文本臆测，产出看似有据的幻觉答案）。
# ============================================================
# VISION_MODEL=qwen2.5vl:7b
# VISION_BASE_URL=http://localhost:11434/v1
# VISION_API_KEY=ollama
# VISION_CONTEXT_WINDOW=8192
#
# 必须显式声明支持图像，否则启动自检会拒绝该角色
# VISION_VISION=true
# VISION_MAX_IMAGES=4          # 单次请求图像数量上限
# VISION_IMAGE_DETAIL=false    # 是否支持 detail: low/high（OpenAI 扩展，非通用）

# 允许读取本地图片的目录（冒号或分号分隔）；默认 assets 与 workspace
# VISION_IMAGE_ROOTS=assets;workspace

# ============================================================
# 关于微信 / QQ（如实说明，避免你走弯路）
#
#   个人微信：官方**无** API。第三方方案基于逆向/hook，违反用户协议，封号风险高。
#   个人 QQ ：官方 bot 平台需企业/组织资质审核，个人开发者很难通过。
#   企业微信：有正规 API，但需要企业/组织才能注册。
#   钉钉    ：群机器人 webhook 个人可用、免费，是唯一能正规落地的选择。
#
# 但本方案不绑定任何平台 —— 交互式审批在网页里，IM 只负责「发一条带链接的消息」。
# 所以任何能发消息的通道（钉钉/企业微信/Slack/Telegram/邮件）都能用，
# 新增一个平台只需实现 core/notify.py 里的一个 Notifier。
# ============================================================
