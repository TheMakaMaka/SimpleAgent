# ============================================================
# 运行产物（可随时删除，不入库）
# ============================================================
.checkpoints/
storage_data/
tests/output/
sessions/*.json
.ruff_cache/
# 每轮的一次性临时件（角色简报约定：临时产物一律放 .tmp/ 或系统临时目录）
.tmp/

# workspace 是 agent 的产出目录，且**内部含一个独立 git 仓库**（回退机制用）。
# 直接提交会被 git 当成嵌套仓库（只记 gitlink，不记内容），容易踩坑。
# 若确实想公开模型产出的示例代码，见 docs/PUSH_TO_GITHUB.md 的「方式 2」。
workspace/

# outputs/ 是**输出根**（P14 交付物落这里）—— 运行产物，不入库。
# 路径可由 AGENT_OUTPUT_DIR 覆盖（见 .env.example / core/runtime.py）。
outputs/

# ============================================================
# 本地凭据与配置 —— 绝不入库
# ============================================================
# .env 含 API key / base_url，属于凭据，不得提交
.env
.env.*
!.env.example

# 凭据类文件（各种可能的名字都挡一遍）
credentials*
*_credentials.json
*token*
*secret*
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
gh_config*
.git-credentials

# 本地 git 配置（可能含 remote 里的 token）
.gitconfig.local

# ============================================================
# 技能是**资产**，不是遥测（例外规则）
#
# 注意 git 的语义：目录一旦被排除，git 就不会进入它，因此必须先重新包含目录，
# 再放行子目录，最后逐一排除其余内容。**不能只写 `!storage_data/skills/`** ——
# 那样父目录仍被排除，例外不会生效。
# 也不能写 `!storage_data/` —— 那样会把 snapshots 等一并放进来（实测踩过）。
# ============================================================
!storage_data/
storage_data/*
!storage_data/skills/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ============================================================
# 编辑器 / 系统
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
